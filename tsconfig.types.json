{
  "extends": "@tsconfig/recommended",
  "include": ["src"],
  "compilerOptions": {
    "declaration": true,
    "emitDeclarationOnly": true,
    "jsx": "react-jsx",
    "lib": [
      "ES2024.SharedMemory"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noUncheckedIndexedAccess": true,
    "outDir": "build",
    "rootDir": "./src",
    "verbatimModuleSyntax": true
  }
}
