{
  "extends": "@tsconfig/recommended",
  "compilerOptions": {
    "declaration": true,
    "jsx": "react-jsx",
    "lib": [
      "ES2024.SharedMemory",
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noUncheckedIndexedAccess": true,
    "outDir": "build",
    "rootDir": ".",
    "types": ["node"],
    "verbatimModuleSyntax": true
  }
}
