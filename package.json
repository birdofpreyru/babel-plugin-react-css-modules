{
  "version": "8.0.0",
  "dependencies": {
    "@babel/core": "^8.0.6",
    "@babel/plugin-syntax-jsx": "^8.0.1",
    "@babel/traverse": "^8.0.6",
    "@babel/types": "^8.0.6",
    "@dr.pogodin/postcss-modules-parser": "^1.4.0",
    "cssesc": "^3.0.0",
    "loader-utils": "^3.3.1",
    "memfs": "^4.80.0",
    "postcss-modules-extract-imports": "^3.1.0",
    "postcss-modules-local-by-default": "^4.2.0",
    "postcss-modules-scope": "^3.2.1",
    "postcss-modules-values": "^4.0.0",
    "zod": "^4.6.5"
  },
  "description": "Transforms styleName to className using compile time CSS module resolution.",
  "devDependencies": {
    "@babel/cli": "^8.0.6",
    "@babel/helper-plugin-test-runner": "^8.0.0",
    "@babel/preset-env": "^8.0.6",
    "@dr.pogodin/babel-plugin-add-import-extension": "^3.0.2",
    "@dr.pogodin/eslint-configs": "^0.3.7",
    "@jest/globals": "^30.5.2",
    "@tsconfig/recommended": "^1.0.13",
    "@types/cssesc": "^3.0.2",
    "@types/loader-utils": "^3.0.0",
    "@types/postcss-modules-extract-imports": "^3.0.5",
    "@types/postcss-modules-local-by-default": "^4.0.2",
    "@types/postcss-modules-scope": "^3.0.4",
    "@types/postcss-modules-values": "^4.0.2",
    "babel-jest": "^30.5.2",
    "babel-plugin-external-helpers": "npm:@babel/plugin-external-helpers@^8.0.1",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-plugin-transform-import-meta": "^3.0.0",
    "jest": "^30.5.2",
    "postcss": "^8.5.28",
    "postcss-less": "^6.0.0",
    "postcss-nested": "^7.0.2",
    "postcss-scss": "^4.0.9",
    "typescript": "^6.0.3",
    "webpack": "^5.111.1"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/birdofpreyru"
  },
  "peerDependencies": {
    "postcss": "8",
    "webpack": ">=5.108"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "babel",
    "css",
    "javascript",
    "modules",
    "plugin",
    "react",
    "web"
  ],
  "license": "BSD-3-Clause",
  "name": "@dr.pogodin/babel-plugin-react-css-modules",
  "homepage": "https://dr.pogodin.studio/docs/babel-plugin-react-css-modules",
  "repository": "github:birdofpreyru/babel-plugin-react-css-modules",
  "bugs": {
    "url": "https://github.com/birdofpreyru/babel-plugin-react-css-modules/issues"
  },
  "scripts": {
    "build": "rm -rf ./build && npm run build:node && npm run build:browser && npm run build:types",
    "build:browser": "NODE_ENV=production babel ./src/getClassName.ts ./src/optionsDefaults.ts --config-file ./babel.build.browser.config.mjs --out-dir ./build/browser --source-maps -x .ts",
    "build:node": "NODE_ENV=production babel ./src --config-file ./babel.build.config.mjs --out-dir ./build --source-maps -x .ts",
    "build:types": "tsc --project tsconfig.types.json",
    "lint": "eslint --cache",
    "jest": "jest --no-cache",
    "test": "npm run lint && npm run typecheck && npm run jest",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    },
    "./getClassName": "./build/browser/getClassName.js",
    "./utils": {
      "types": "./build/utils.d.ts",
      "default": "./build/utils.js"
    }
  },
  "type": "module"
}
